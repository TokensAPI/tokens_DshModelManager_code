{
    "name": "@tokens/dsh-model-manager",
    "version": "0.2.1",
    "description": "TokensAPI managed model and vision provider for DeepSeek Harness Desktop",
    "type": "module",
    "bin": {
        "modlens": "./dist/main.js"
    },
    "scripts": {
        "dev": "vite build --watch",
        "build": "vite build",
        "prepublishOnly": "pnpm build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "coverage": "vitest run --coverage",
        "lint": "biome check src scripts dsh",
        "format": "biome check --write src scripts",
        "eval": "node evals/run.mjs",
        "release": "node scripts/release.mjs",
        "docs:list": "node scripts/docs-list.js"
    },
    "files": [
        "dist",
        "docs",
        "skills/modlens/SKILL.md",
        "skills/modlens/scripts",
        "skills/modlens/references",
        "CHANGELOG.md",
        "SECURITY.md",
        "dsh",
        "cordis.patch.yml",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
    ],
    "keywords": [
        "cli",
        "vision",
        "ocr",
        "antigravity",
        "agent-skill",
        "claude-code",
        "skill",
        "image-to-text",
        "multimodal",
        "modlens"
    ],
    "author": "TokensAPI contributors; based on ModLens by Leon Liu",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TokensAPI/tokens_DshModelManager_code.git"
    },
    "bugs": {
        "url": "https://github.com/TokensAPI/tokens_DshModelManager_code/issues"
    },
    "homepage": "https://github.com/TokensAPI/tokens_DshModelManager_code#readme",
    "engines": {
        "node": ">=22.19"
    },
    "dependencies": {
        "commander": "^13.1.0",
        "undici": "^8.10.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.7",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^3.2.7",
        "typescript": "^5.9.3",
        "vite": "^6.4.1",
        "vitest": "^3.2.7"
    },
    "exports": {
        ".": "./dsh/index.js",
        "./dsh": "./dsh/index.js",
        "./package.json": "./package.json",
        "./client": "./dsh/client.js"
    },
    "dsh": {
        "skillDirectory": "modlens",
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [],
            "platform": "web",
            "immediately": true
        }
    }
}
